\"version\":30,\"id_type\":\"stableID\",\"value\":{\"encoding\":\"gzip\"},\"is_device_based\":true,\"group_name\":\"Gzip\",\"is_experiment_active\":false,\"is_user_in_experiment\":false},\"1851602600\":{\"name\":\"1851602600\",\"rule_id\":\"4eTK4MlItkURcyZvgC5EMN-4eTK4KGG12LmT9rzFua1tL\",\"secondary_exposures\":[],\"version\":5,\"id_type\":\"userID\",\"value\":{\"mode\":\"composer\",\"placeholder\":\"How would you like to personalize your lessons?\",\"suggestions\":[{\"id\":\"shorter\",\"label\":\"Shorter lessons\",\"prompt\":\"Make the lessons in my course shorter\"},{\"id\":\"basics\",\"label\":\"More basics\",\"prompt\":\"Focus my course more on the basics, with simpler explanations\"},{\"label\":\"More conversation practice\",\"prompt\":\"Add more conversation practice to my course\",\"id\":\"conversation\"}]},\"is_device_based\":false,\"passed\":true},\"1935984042\":{\"name\":\"1935984042\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":79,\"id_type\":\"userID\",\"value\":{\"enabled_document_types\":[\"page\",\"granola_workbook\",\"granola_presentation\",\"granola_whiteboard\"],\"native_document_limits\":{\"granola_presentation\":{\"max_document_depth\":64,\"max_materialized_markdown_bytes\":1048576,\"max_raw_update_bytes\":524288,\"max_title_unicode_scalars\":512,\"max_document_bytes\":10485760,\"max_document_nodes\":250000,\"max_block_count\":10000},\"granola_whiteboard\":{\"max_document_depth\":64,\"max_materialized_markdown_bytes\":1048576,\"max_title_unicode_scalars\":512,\"max_block_count\":10000,\"max_raw_update_bytes\":524288,\"max_document_nodes\":250000,\"max_document_bytes\":10485760},\"granola_workbook\":{\"max_document_nodes\":250000,\"max_document_bytes\":10485760,\"max_materialized_markdown_bytes\":1048576,\"max_title_unicode_scalars\":512,\"max_document_depth\":64,\"max_block_count\":10000,\"max_raw_update_bytes\":524288}}},\"is_device_based\":false,\"passed\":false},\"1965446322\":{\"name\":\"1965446322\",\"rule_id\":\"launchedG