t-primary,var(--color-token-text-primary,var(--text-primary,#0d0d0d))); --oai-wb-text-secondary: var(--wb-text-secondary,var(--color-token-text-secondary,var(--text-secondary,#5d5d5d))); --oai-wb-text-tertiary: var(--wb-text-tertiary,var(--color-token-text-tertiary,var(--text-tertiary,#8f8f8f))); --oai-wb-surface-primary: var(--wb-surface-primary,var(--color-token-main-surface-primary,var(--main-surface-primary,#fff))); --oai-wb-surface-secondary: var(--wb-surface-secondary,var(--color-token-bg-tertiary,var(--main-surface-secondary,#f5f5f5))); --oai-wb-interactive-secondary-hover: var(--wb-interactive-secondary-hover,var(--color-token-interactive-bg-secondary-hover,var(--oai-wb-surface-secondary))); --oai-wb-border: var(--wb-border,var(--color-token-border,var(--border-light,rgb(0 0 0/8%)))); --oai-wb-border-hover: var(--wb-border-hover,var(--color-token-border-default,var(--border-medium,rgb(0 0 0/12%)))); --oai-wb-divider: var(--wb-divider,var(--color-token-border-light,var(--border-light,rgb(0 0 0/5%)))); --oai-wb-focus: var(--wb-focus,var(--color-token-focus-border,var(--border-strong,#5b9dd9))); --oai-wb-control-border: var(--wb-control-border,var(--interactive-border-focus,var(--oai-wb-focus))); --oai-wb-entity-accent: var(--wb-entity-accent,var(--theme-entity-accent,var(--oai-wb-accent))); --oai-wb-accent: var(--wb-accent,var(--interactive-label-accent-default,#0285ff)); --oai-wb-on-accent: var(--wb-on-accent,var(--bg-primary,#fff)); --oai-wb-interactive-background: var(--wb-interactive-background,var(--interactive-bg-accent-default,color-mix(in srgb,#0285ff 12%,transparent))); --oai-wb-selection: var(--wb-selection,var(--theme-user-selection-bg,var(--selection,#93c5fd))); --oai-wb-radius: var(--wb-radius,1.5rem); --oai-wb-radius-sm: var(--wb-radius-sm,0.5rem); --oai-wb-shadow: var(--wb-shadow,0 4px 80px rgb(0 0 0/2%)); --oai-wb-shadow-lg: var(--wb-shadow-lg,0 10px 30px rgb(0 0 0/12%)); --oai-wb-font-sans: var(--wb-font-sans,var(--font-sans,sans-serif)); --oai-wb-font-mono: var(--wb-font-mono,var(--font-mono,monospace)); --oai-wb-font-size: var(--wb-font-size,0.875rem); --oai-wb-shimmer-dark-contrast: var(--wb-shimmer-dark-contrast,var(--oai-wb-text-tertiary)); --oai-wb-shimmer-dark-secondary: var(--wb-shimmer-dark-secondary,var(--oai-wb-text-tertiary));"><div contenteditable="true" aria-label="Start writing" aria-multiline="true" role="textbox" translate="no" class="ProseMirror content-xaiQhS leading-relaxed"><h1 dir="auto"><span>MASTER PROMPT: COMPLETE WEB-BASED FILE EXPLORER &amp; FILE MANAGEMENT SYSTEM</span></h1><p dir="auto"><span>Act as a senior full-stack developer, file-system architect, document management engineer and UI/UX designer.</span></p><p dir="auto"><span>Build a complete, professional File Explorer module inside my existing website.</span></p><p dir="auto"><span>IMPORTANT: I do not want a basic PDF reader, notes viewer or movie player. I want a complete file management platform with the functionality of a modern desktop file explorer.</span></p><p dir="auto"><span>First inspect my existing project and integrate this module without breaking existing features.</span></p><h2 dir="auto"><span>1. MAIN OBJECTIVE</span></h2><p dir="auto"><span>Create a complete File Explorer where users can manage all supported files and folders from one interface.</span></p><p dir="auto"><span>The system should support:</span></p><ul data-spread="false"><li><p dir="auto"><span>Documents</span></p></li><li><p dir="auto"><span>PDF files</span></p></li><li><p dir="auto"><span>Notes</span></p></li><li><p dir="auto"><span>Text files</span></p></li><li><p dir="auto"><span>Word documents</span></p></li><li><p dir="auto"><span>Excel spreadsheets</span></p></li><li><p dir="auto"><span>PowerPoint presentations</span></p></li><li><p dir="auto"><span>Images</span></p></li><li><p dir="auto"><span>Videos and movies</span></p></li><li><p dir="auto"><span>Audio and music</span></p></li><li><p dir="auto"><span>ZIP archives</span></p></li><li><p dir="auto"><span>Source code files</span></p></li><li><p dir="auto"><span>JSON, XML and CSV files</span></p></li><li><p dir="auto"><span>Other common file formats</span></p></li></ul><p dir="auto"><span>Do not restrict the system to PDFs and movies.</span></p><h2 dir="auto"><span>2. FILE EXPLORER INTERFACE</span></h2><p dir="auto"><span>Create a professional desktop-style file manager.</span></p><p dir="auto"><span>Main layout:</span></p><p dir="auto"><span>LEFT SIDEBAR:</span></p><ul data-spread="false"><li><p dir="auto"><span>Home</span></p></li><li><p dir="auto"><span>All Files</span></p></li><li><p dir="auto"><span>Recent Files</span></p></li><li><p dir="auto"><span>Favorites</span></p></li><li><p dir="auto"><span>Starred</span></p></li><li><p dir="auto"><span>Documents</span></p></li><li><p dir="auto"><span>PDF Documents</span></p></li><li><p dir="auto"><span>Notes</span></p></li><li><p dir="auto"><span>Images</span></p></li><li><p dir="auto"><span>Videos</span></p></li><li><p dir="auto"><span>Music</span></p></li><li><p dir="auto"><span>Downloads</span></p></li><li><p dir="auto"><span>Archives</span></p></li><li><p dir="auto"><span>Trash</span></p></li><li><p dir="auto"><span>Shared Files</span></p></li><li><p dir="auto"><span>Storage Information</span></p></li></ul><p dir="auto"><span>TOP TOOLBAR:</span></p><ul data-spread="false"><li><p dir="auto"><span>Back</span></p></li><li><p dir="auto"><span>Forward</span></p></li><li><p dir="auto"><span>Up one folder</span></p></li><li><p dir="auto"><span>Refresh</span></p></li><li><p dir="auto"><span>Breadcrumb navigation</span></p></li><li><p dir="auto"><span>Search files</span></p></li><li><p dir="auto"><span>New Folder</span></p></li><li><p dir="auto"><span>Upload Files</span></p></li><li><p dir="auto"><span>Upload Folder</span></p></li><li><p dir="auto"><span>Sort</span></p></li><li><p dir="auto"><span>Filter</span></p></li><li><p dir="auto"><span>Grid View</span></p></li><li><p dir="auto"><span>List View</span></p></li><li><p dir="auto"><span>Settings</span></p></li></ul><p dir="auto"><span>MAIN CONTENT:</span></p><ul data-spread="false"><li><p dir="auto"><span>File and folder cards</span></p></li><li><p dir="auto"><span>File icons and thumbnails</span></p></li><li><p dir="auto"><span>File names</span></p></li><li><p dir="auto"><span>File sizes</span></p></li><li><p dir="auto"><span>File types</span></p></li><li><p dir="auto"><span>Modified dates</span></p></li><li><p dir="auto"><span>Selection checkboxes</span></p></li><li><p dir="auto"><span>Right-click context menu</span></p></li><li><p dir="auto"><span>Drag-and-drop file management</span></p></li></ul><p dir="auto"><span>RIGHT INFORMATION PANEL:</span></p><ul data-spread="false"><li><p dir="auto"><span>Selected file preview</span></p></li><li><p dir="auto"><span>File name</span></p></li><li><p dir="auto"><span>File type</span></p></li><li><p dir="auto"><span>Size</span></p></li><li><p dir="auto"><span>Creation date</span></p></li><li><p dir="auto"><span>Last modified date</span></p></li><li><p dir="auto"><span>Location</span></p></li><li><p dir="auto"><span>File properties</span></p></li></ul><h2 dir="auto"><span>3. COMPLETE FILE MANAGEMENT OPERATIONS</span></h2><p dir="auto"><span>Implement real working operations:</span></p><ol start="1" data-spread="false" style="--rich-text-list-marker-width: 2ch;"><li><p dir="auto"><span>Create folders.</span></p></li><li><p dir="auto"><span>Create subfolders.</span></p></li><li><p dir="auto"><span>Upload individual files.</span></p></li><li><p dir="auto"><span>Upload multiple files.</span></p></li><li><p dir="auto"><span>Upload folders where supported.</span></p></li><li><p dir="auto"><span>Download files.</span></p></li><li><p dir="auto"><span>Download folders as ZIP archives.</span></p></li><li><p dir="auto"><span>Rename files.</span></p></li><li><p dir="auto"><span>Rename folders.</span></p></li><li><p dir="auto"><span>Copy files.</span></p></li><li><p dir="auto"><span>Cut files.</span></p></li><li><p dir="auto"><span>Paste files.</span></p></li><li><p dir="auto"><span>Move files.</span></p></li><li><p dir="auto"><span>Duplicate files.</span></p></li><li><p dir="auto"><span>Delete files.</span></p></li><li><p dir="auto"><span>Delete folders.</span></p></li><li><p dir="auto"><span>Restore deleted files.</span></p></li><li><p dir="auto"><span>Permanently delete files.</span></p></li><li><p dir="auto"><span>Select multiple files.</span></p></li><li><p dir="auto"><span>Bulk operations.</span></p></li><li><p dir="auto"><span>Drag and drop files.</span></p></li><li><p dir="auto"><span>Add to favorites.</span></p></li><li><p dir="auto"><span>Remove from favorites.</span></p></li><li><p dir="auto"><span>Sort by name, size, type and date.</span></p></li><li><p dir="auto"><span>Search by filename and file type.</span></p></li><li><p dir="auto"><span>Filter by file category.</span></p></li><li><p dir="auto"><span>View file properties.</span></p></li><li><p dir="auto"><span>Show storage usage.</span></p></li></ol><p dir="auto"><span>Every operation must work with actual stored files, not just update the interface.</span></p><h2 dir="auto"><span>4. DOCUMENT VIEWERS</span></h2><p dir="auto"><span>Build an integrated document viewer.</span></p><p dir="auto"><span>PDF:</span></p><ul data-spread="false"><li><p dir="auto"><span>Open PDF files.</span></p></li><li><p dir="auto"><span>Page navigation.</span></p></li><li><p dir="auto"><span>Zoom in and out.</span></p></li><li><p dir="auto"><span>Search within PDF.</span></p></li><li><p dir="auto"><span>Full-screen reading.</span></p></li><li><p dir="auto"><span>Download.</span></p></li><li><p dir="auto"><span>Print.</span></p></li><li><p dir="auto"><span>Page thumbnails.</span></p></li><li><p dir="auto"><span>Remember last-read page.</span></p></li></ul><p dir="auto"><span>Word:</span></p><ul data-spread="false"><li><p dir="auto"><span>Preview DOC and DOCX.</span></p></li><li><p dir="auto"><span>Support document editing where feasible.</span></p></li><li><p dir="auto"><span>Download original document.</span></p></li></ul><p dir="auto"><span>Excel:</span></p><ul data-spread="false"><li><p dir="auto"><span>Preview XLS and XLSX.</span></p></li><li><p dir="auto"><span>Display worksheets.</span></p></li><li><p dir="auto"><span>Navigate between sheets.</span></p></li><li><p dir="auto"><span>Display rows and columns.</span></p></li><li><p dir="auto"><span>Preserve original files.</span></p></li></ul><p dir="auto"><span>PowerPoint:</span></p><ul data-spread="false"><li><p dir="auto"><span>Preview PPT and PPTX.</span></p></li><li><p dir="auto"><span>Slide navigation.</span></p></li><li><p dir="auto"><span>Full-screen presentation.</span></p></li><li><p dir="auto"><span>Download original file.</span></p></li></ul><p dir="auto"><span>Text:</span></p><ul data-spread="false"><li><p dir="auto"><span>Read TXT, MD, LOG and RTF files.</span></p></li><li><p dir="auto"><span>Search text.</span></p></li><li><p dir="auto"><span>Copy content.</span></p></li><li><p dir="auto"><span>Edit and save supported text formats.</span></p></li></ul><p dir="auto"><span>CSV:</span></p><ul data-spread="false"><li><p dir="auto"><span>Display data in tables.</span></p></li><li><p dir="auto"><span>Search and filter rows.</span></p></li><li><p dir="auto"><span>Export and download.</span></p></li></ul><h2 dir="auto"><span>5. NOTES MANAGEMENT</span></h2><p dir="auto"><span>Create a built-in Notes Manager.</span></p><p dir="auto"><span>Features:</span></p><ul data-spread="false"><li><p dir="auto"><span>Create notes.</span></p></li><li><p dir="auto"><span>Edit notes.</span></p></li><li><p dir="auto"><span>Delete notes.</span></p></li><li><p dir="auto"><span>Rename notes.</span></p></li><li><p dir="auto"><span>Auto-save.</span></p></li><li><p dir="auto"><span>Markdown support.</span></p></li><li><p dir="auto"><span>Rich-text editor.</span></p></li><li><p dir="auto"><span>Search notes.</span></p></li><li><p dir="auto"><span>Organize notes into folders.</span></p></li><li><p dir="auto"><span>Pin important notes.</span></p></li><li><p dir="auto"><span>Favorite notes.</span></p></li><li><p dir="auto"><span>Export notes as TXT, MD or PDF where supported.</span></p></li></ul><p dir="auto"><span>Support local autosave and server-side persistence where the backend is configured.</span></p><h2 dir="auto"><span>6. VIDEO AND MOVIE PLAYER</span></h2><p dir="auto"><span>Build an integrated media player.</span></p><p dir="auto"><span>Supported formats should include common browser-playable formats such as MP4, WebM and supported audio/video codecs.</span></p><p dir="auto"><span>Features:</span></p><ul data-spread="false"><li><p dir="auto"><span>Video preview thumbnails.</span></p></li><li><p dir="auto"><span>Play and pause.</span></p></li><li><p dir="auto"><span>Seek and timeline.</span></p></li><li><p dir="auto"><span>Volume control.</span></p></li><li><p dir="auto"><span>Playback speed.</span></p></li><li><p dir="auto"><span>Full-screen mode.</span></p></li><li><p dir="auto"><span>Picture-in-picture where supported.</span></p></li><li><p dir="auto"><span>Subtitle support.</span></p></li><li><p dir="auto"><span>Resume playback.</span></p></li><li><p dir="auto"><span>Recently watched.</span></p></li><li><p dir="auto"><span>Video metadata.</span></p></li><li><p dir="auto"><span>Search videos.</span></p></li><li><p dir="auto"><span>Sort by duration and date.</span></p></li></ul><p dir="auto"><span>Do not claim every video codec is supported by every browser. Provide an appropriate fallback for unsupported files.</span></p><h2 dir="auto"><span>7. IMAGE VIEWER</span></h2><p dir="auto"><span>Features:</span></p><ul data-spread="false"><li><p dir="auto"><span>Preview images.</span></p></li><li><p dir="auto"><span>Zoom.</span></p></li><li><p dir="auto"><span>Rotate.</span></p></li><li><p dir="auto"><span>Full-screen view.</span></p></li><li><p dir="auto"><span>Next and previous image.</span></p></li><li><p dir="auto"><span>Slideshow.</span></p></li><li><p dir="auto"><span>Image metadata.</span></p></li><li><p dir="auto"><span>Download original image.</span></p></li></ul><p dir="auto"><span>Support JPEG, PNG, WebP, GIF, SVG and other browser-supported formats with safe rendering.</span></p><h2 dir="auto"><span>8. MUSIC AND AUDIO PLAYER</span></h2><p dir="auto"><span>Features:</span></p><ul data-spread="false"><li><p dir="auto"><span>Audio playback.</span></p></li><li><p dir="auto"><span>Playlist creation.</span></p></li><li><p dir="auto"><span>Play and pause.</span></p></li><li><p dir="auto"><span>Next and previous.</span></p></li><li><p dir="auto"><span>Volume.</span></p></li><li><p dir="auto"><span>Seek.</span></p></li><li><p dir="auto"><span>Playback speed.</span></p></li><li><p dir="auto"><span>Recently played.</span></p></li><li><p dir="auto"><span>Favorite tracks.</span></p></li><li><p dir="auto"><span>Album and artist metadata where available.</span></p></li></ul><h2 dir="auto"><span>9. ARCHIVE MANAGER</span></h2><p dir="auto"><span>Support:</span></p><ul data-spread="false"><li><p dir="auto"><span>ZIP archive inspection.</span></p></li><li><p dir="auto"><span>List archive contents.</span></p></li><li><p dir="auto"><span>Extract ZIP files.</span></p></li><li><p dir="auto"><span>Create ZIP archives.</span></p></li><li><p dir="auto"><span>Download extracted files.</span></p></li></ul><p dir="auto"><span>Validate archive paths and prevent ZIP Slip and archive-bomb attacks.</span></p><p dir="auto"><span>For unsupported archive formats, show a clear message rather than pretending to extract them.</span></p><h2 dir="auto"><span>10. ADVANCED SEARCH</span></h2><p dir="auto"><span>Create a powerful file search system.</span></p><p dir="auto"><span>Search by:</span></p><ul data-spread="false"><li><p dir="auto"><span>File name.</span></p></li><li><p dir="auto"><span>File extension.</span></p></li><li><p dir="auto"><span>File type.</span></p></li><li><p dir="auto"><span>Folder.</span></p></li><li><p dir="auto"><span>File size.</span></p></li><li><p dir="auto"><span>Creation date.</span></p></li><li><p dir="auto"><span>Modified date.</span></p></li><li><p dir="auto"><span>File contents for supported indexed formats.</span></p></li></ul><p dir="auto"><span>Include:</span></p><ul data-spread="false"><li><p dir="auto"><span>Instant search.</span></p></li><li><p dir="auto"><span>Search suggestions.</span></p></li><li><p dir="auto"><span>Recent searches.</span></p></li><li><p dir="auto"><span>Advanced filters.</span></p></li><li><p dir="auto"><span>Search results grouped by file category.</span></p></li></ul><h2 dir="auto"><span>11. STORAGE AND FILE SECURITY</span></h2><p dir="auto"><span>Implement:</span></p><ul data-spread="false"><li><p dir="auto"><span>Storage usage dashboard.</span></p></li><li><p dir="auto"><span>File size tracking.</span></p></li><li><p dir="auto"><span>Upload progress.</span></p></li><li><p dir="auto"><span>Download progress.</span></p></li><li><p dir="auto"><span>Upload cancellation.</span></p></li><li><p dir="auto"><span>File size limits.</span></p></li><li><p dir="auto"><span>Allowed file type configuration.</span></p></li><li><p dir="auto"><span>File validation.</span></p></li><li><p dir="auto"><span>Authentication.</span></p></li><li><p dir="auto"><span>Role-based permissions.</span></p></li><li><p dir="auto"><span>Per-user file ownership.</span></p></li><li><p dir="auto"><span>Private file access.</span></p></li><li><p dir="auto"><span>Secure download authorization.</span></p></li><li><p dir="auto"><span>Audit logs.</span></p></li><li><p dir="auto"><span>Trash retention and recovery.</span></p></li></ul><p dir="auto"><span>Never expose private files through predictable public URLs.</span></p><p dir="auto"><span>Prevent:</span></p><ul data-spread="false"><li><p dir="auto"><span>Path traversal.</span></p></li><li><p dir="auto"><span>Unauthorized file access.</span></p></li><li><p dir="auto"><span>Malicious uploads.</span></p></li><li><p dir="auto"><span>Unsafe archive extraction.</span></p></li><li><p dir="auto"><span>Executing uploaded files.</span></p></li><li><p dir="auto"><span>Cross-user file access.</span></p></li></ul><h2 dir="auto"><span>12. STORAGE ARCHITECTURE</span></h2><p dir="auto"><span>Use the existing backend and database if present.</span></p><p dir="auto"><span>Support an extensible storage architecture:</span></p><ul data-spread="false"><li><p dir="auto"><span>Local server storage.</span></p></li><li><p dir="auto"><span>Object storage such as S3-compatible storage.</span></p></li><li><p dir="auto"><span>Cloud storage adapters where configured.</span></p></li></ul><p dir="auto"><span>Store file metadata in the database and file contents in the configured storage backend.</span></p><p dir="auto"><span>Suggested database entities:</span></p><ul data-spread="false"><li><p dir="auto"><span>User</span></p></li><li><p dir="auto"><span>File</span></p></li><li><p dir="auto"><span>Folder</span></p></li><li><p dir="auto"><span>FileVersion</span></p></li><li><p dir="auto"><span>Favorite</span></p></li><li><p dir="auto"><span>FileShare</span></p></li><li><p dir="auto"><span>FilePermission</span></p></li><li><p dir="auto"><span>TrashItem</span></p></li><li><p dir="auto"><span>RecentFile</span></p></li><li><p dir="auto"><span>AuditLog</span></p></li></ul><p dir="auto"><span>Implement file ownership, folder hierarchy, permissions and safe storage paths.</span></p><h2 dir="auto"><span>13. LOCAL COMPUTER FILE ACCESS</span></h2><p dir="auto"><span>Important browser limitation:</span></p><p dir="auto"><span>A website cannot silently access every file on a visitor's computer.</span></p><p dir="auto"><span>Implement:</span></p><ul data-spread="false"><li><p dir="auto"><span>Standard file upload using the browser file picker.</span></p></li><li><p dir="auto"><span>Folder upload where supported.</span></p></li><li><p dir="auto"><span>Drag-and-drop upload.</span></p></li><li><p dir="auto"><span>File System Access API where supported and explicitly authorized.</span></p></li><li><p dir="auto"><span>Download to the user's device.</span></p></li><li><p dir="auto"><span>Permission-aware local folder access.</span></p></li></ul><p dir="auto"><span>Never attempt to bypass browser security or access unauthorized computer files.</span></p><p dir="auto"><span>Clearly distinguish between:</span></p><ol start="1" data-spread="false" style="--rich-text-list-marker-width: 1ch;"><li><p dir="auto"><span>Files stored in the website.</span></p></li><li><p dir="auto"><span>Files selected from the user's local computer.</span></p></li><li><p dir="auto"><span>Files stored in connected cloud storage.</span></p></li></ol><h2 dir="auto"><span>14. UI/UX DESIGN</span></h2><p dir="auto"><span>Design the file manager with:</span></p><ul data-spread="false"><li><p dir="auto"><span>Professional dark and light themes.</span></p></li><li><p dir="auto"><span>Modern desktop file explorer layout.</span></p></li><li><p dir="auto"><span>Responsive mobile interface.</span></p></li><li><p dir="auto"><span>Grid and list views.</span></p></li><li><p dir="auto"><span>File-type icons.</span></p></li><li><p dir="auto"><span>File thumbnails.</span></p></li><li><p dir="auto"><span>Context menus.</span></p></li><li><p dir="auto"><span>Keyboard shortcuts.</span></p></li><li><p dir="auto"><span>Breadcrumb navigation.</span></p></li><li><p dir="auto"><span>Smooth animations.</span></p></li><li><p dir="auto"><span>Upload progress indicators.</span></p></li><li><p dir="auto"><span>Empty states.</span></p></li><li><p dir="auto"><span>Loading states.</span></p></li><li><p dir="auto"><span>Error messages.</span></p></li><li><p dir="auto"><span>Confirmation dialogs.</span></p></li></ul><p dir="auto"><span>The interface should feel like a combination of Windows File Explorer and a modern cloud drive.</span></p><h2 dir="auto"><span>15. API AND BACKEND</span></h2><p dir="auto"><span>Create appropriate APIs for:</span></p><ul data-spread="false"><li><p dir="auto"><span>File listing.</span></p></li><li><p dir="auto"><span>Folder creation.</span></p></li><li><p dir="auto"><span>File upload.</span></p></li><li><p dir="auto"><span>File download.</span></p></li><li><p dir="auto"><span>Rename.</span></p></li><li><p dir="auto"><span>Copy.</span></p></li><li><p dir="auto"><span>Move.</span></p></li><li><p dir="auto"><span>Delete.</span></p></li><li><p dir="auto"><span>Restore.</span></p></li><li><p dir="auto"><span>Search.</span></p></li><li><p dir="auto"><span>File metadata.</span></p></li><li><p dir="auto"><span>Favorites.</span></p></li><li><p dir="auto"><span>Storage analytics.</span></p></li><li><p dir="auto"><span>File previews.</span></p></li><li><p dir="auto"><span>File permissions.</span></p></li><li><p dir="auto"><span>Sharing.</span></p></li></ul><p dir="auto"><span>Use authenticated and authorized endpoints.</span></p><p dir="auto"><span>Implement pagination for large directories and streaming for large file uploads/downloads.</span></p><h2 dir="auto"><span>16. DEVELOPMENT PHASES</span></h2><p dir="auto"><span>Phase 1: Inspect the existing website and identify the technology stack.</span></p><p dir="auto"><span>Phase 2: Design the file explorer UI.</span></p><p dir="auto"><span>Phase 3: Implement folder and file storage.</span></p><p dir="auto"><span>Phase 4: Implement complete file management operations.</span></p><p dir="auto"><span>Phase 5: Implement document readers and viewers.</span></p><p dir="auto"><span>Phase 6: Implement notes, image, audio and video viewers.</span></p><p dir="auto"><span>Phase 7: Implement ZIP management.</span></p><p dir="auto"><span>Phase 8: Implement search, favorites, history and storage analytics.</span></p><p dir="auto"><span>Phase 9: Implement authentication and permissions.</span></p><p dir="auto"><span>Phase 10: Test every operation and file type.</span></p><p dir="auto"><span>Phase 11: Optimize performance and prepare production deployment.</span></p><h2 dir="auto"><span>17. FINAL ACCEPTANCE REQUIREMENTS</span></h2><p dir="auto"><span>The module must:</span></p><ul data-spread="false"><li><p dir="auto"><span>Work inside my existing website.</span></p></li><li><p dir="auto"><span>Manage real uploaded files.</span></p></li><li><p dir="auto"><span>Create and manage folder hierarchies.</span></p></li><li><p dir="auto"><span>Read PDFs and documents.</span></p></li><li><p dir="auto"><span>Create and manage notes.</span></p></li><li><p dir="auto"><span>Play supported movies and audio.</span></p></li><li><p dir="auto"><span>Preview images.</span></p></li><li><p dir="auto"><span>Manage ZIP files.</span></p></li><li><p dir="auto"><span>Search and organize files.</span></p></li><li><p dir="auto"><span>Support bulk operations.</span></p></li><li><p dir="auto"><span>Work on desktop and mobile.</span></p></li><li><p dir="auto"><span>Protect private user files.</span></p></li><li><p dir="auto"><span>Preserve files across page reloads and sessions.</span></p></li><li><p dir="auto"><span>Handle errors and unsupported formats correctly.</span></p></li></ul><p dir="auto"><span>Deliver complete source code, database changes, APIs, installation instructions, environment configuration, and testing documentation.</span></p><p dir="auto"><span>Do not create a visual-only prototype. Do not use fake data for completed operations. Do not remove existing functionality.</span></p><p dir="auto"><span>Start by inspecting the repository and implement this as a fully integrated File Explorer module.</span></p></div></div></div></div></div></div></div><div aria-hidden="true" class="pointer-events-none absolute inset-0 rounded-[inherit] z-[2] [box-shadow:inset_0_0_0_1px_var(--oai-wb-border)] group-hover/writing-block-surface:[box-shadow:inset_0_0_0_1px_var(--oai-wb-border-hover)]"></div></div></div><h2 class="TextBase-hXhSqg Title-HRvkwB" data-d-text-flow="" data-d-component="title" data-d-size=